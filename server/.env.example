# Copy this file to `.env` (in the server/ folder) and fill in values.
# `.env` is gitignored — never commit real secrets.

# Port the server listens on. Hosts like Render/Railway set this automatically.
PORT=5001

# Secret used to sign login tokens (JWT). MUST be set in production.
# Generate a strong one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid. Examples: 7d, 30d, 12h.
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins (CORS). Leave BLANK in dev to
# allow all origins (needed for local-network / native testing). In production set
# it to your real domains, e.g.:
#   ALLOWED_ORIGINS=https://pickup.yourdomain.com,https://www.pickup.yourdomain.com
ALLOWED_ORIGINS=
