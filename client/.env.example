# Copy this file to `.env` and fill in the values.
#
# The URL of your deployed backend (Express server). This is REQUIRED for the
# native iOS app and for any production web deploy — without it the app tries to
# talk to http://localhost:5001, which does not exist on a phone.
#
# Examples:
#   REACT_APP_API_URL=https://pickup-api.onrender.com
#   REACT_APP_API_URL=https://api.yourdomain.com
REACT_APP_API_URL=
